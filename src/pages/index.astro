---
import { translations } from "../lib/i18n";
---

<!doctype html>
<html lang="en" data-locale="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Amazing Compression Tech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
      rel="stylesheet"
    />

    <script is:inline define:vars={{ en: translations.en, ja: translations.ja }}
    >
      window.__en = en;
      window.__ja = ja;
      var __loc = (function () {
        try {
          var s = localStorage.getItem("act-lang");
          if (s === "ja" || s === "en") return s;
        } catch (e) {}
        return (navigator.language || "").toLowerCase().startsWith("ja")
          ? "ja"
          : "en";
      })();
      window.__locale = __loc;
      window.__t = __loc === "ja" ? ja : en;
      document.documentElement.lang = __loc;
      document.documentElement.setAttribute("data-locale", __loc);
    </script>

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #0c0c0c;
        --surface: #131313;
        --border: #242424;
        --border2: #1a1a1a;
        --text: #f0f0f0;
        --muted: #5a5a5a;
        --subtle: #2a2a2a;
        --accent: #c8ff00;
        --accent-dim: rgba(200, 255, 0, 0.09);
        --red: #ff4f4f;
        --radius: 12px;
        --card-w: 520px;
      }

      body {
        font-family: "Space Grotesk", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem 5rem;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .header {
        width: 100%;
        max-width: var(--card-w);
        margin-bottom: 1.5rem;
      }
      .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.4rem;
      }
      .header h1 {
        font-size: clamp(1.25rem, 3.5vw, 1.75rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1;
        color: var(--text);
      }
      .header h1 em {
        font-style: normal;
        color: var(--accent);
      }
      .header .subtitle {
        font-size: 0.78rem;
        color: var(--muted);
      }

      .lang-row {
        display: flex;
        gap: 2px;
        background: var(--border2);
        border: 1px solid var(--border);
        border-radius: 7px;
        padding: 3px;
        flex-shrink: 0;
      }
      .lang-btn {
        background: transparent;
        color: var(--muted);
        border: none;
        border-radius: 4px;
        padding: 0.22rem 0.55rem;
        font-size: 0.7rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        letter-spacing: 0.06em;
        transition:
          background 0.12s,
          color 0.12s;
      }
      .lang-btn.active {
        background: var(--subtle);
        color: var(--text);
      }

      .card {
        width: 100%;
        max-width: var(--card-w);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.25rem;
      }

      .dropzone {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        min-height: 160px;
        border: 1.5px dashed var(--border);
        border-radius: 9px;
        cursor: pointer;
        padding: 1.75rem 2rem;
        text-align: center;
        transition:
          border-color 0.18s,
          background 0.18s;
        user-select: none;
        -webkit-user-select: none;
        position: relative;
      }
      .dropzone:hover,
      .dropzone.over {
        border-color: var(--accent);
        background: var(--accent-dim);
      }
      .dz-icon {
        width: 32px;
        height: 32px;
        color: var(--muted);
        transition: color 0.18s;
      }
      .dropzone:hover .dz-icon,
      .dropzone.over .dz-icon {
        color: var(--accent);
      }
      .dz-main {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text);
        pointer-events: none;
      }
      .dz-hint {
        font-size: 0.7rem;
        color: var(--muted);
        pointer-events: none;
      }
      #fileInput {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      .file-preview {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.65rem;
        padding: 0.6rem 0.75rem;
        background: var(--border2);
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      .file-preview img {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 5px;
        border: 1px solid var(--border);
        flex-shrink: 0;
        display: block;
      }
      .preview-icon {
        width: 40px;
        height: 40px;
        font-size: 22px;
        display: flex !important;
        align-items: center;
        justify-content: center;
        background: var(--subtle);
        border: 1px solid var(--border);
        border-radius: 5px;
        color: var(--muted);
        flex-shrink: 0;
        vertical-align: 0;
      }
      .file-meta {
        flex: 1;
        min-width: 0;
      }
      .file-name {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .file-type {
        display: block;
        font-size: 0.68rem;
        color: var(--muted);
        margin-top: 0.08rem;
      }

      .error-msg {
        margin-top: 0.65rem;
        padding: 0.6rem 0.75rem;
        background: rgba(255, 79, 79, 0.07);
        border: 1px solid rgba(255, 79, 79, 0.2);
        border-radius: 7px;
        font-size: 0.78rem;
        color: var(--red);
      }

      .divider {
        height: 1px;
        background: var(--border);
        margin: 1rem 0;
      }

      .phase {
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0.65rem;
      }
      .phase.vis {
        display: flex;
      }

      .phase-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }
      .spinner {
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--border);
        border-top-color: var(--text);
        border-radius: 50%;
        animation: spin 0.65s linear infinite;
        flex-shrink: 0;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .phase-label {
        font-size: 0.8rem;
        color: var(--muted);
      }

      .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.45rem;
      }
      .progress-header-label {
        font-size: 0.8rem;
        color: var(--muted);
      }
      #progressPct {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text);
        font-variant-numeric: tabular-nums;
        min-width: 3ch;
        text-align: right;
      }
      .progress-track {
        height: 3px;
        background: var(--border);
        border-radius: 99px;
        overflow: hidden;
      }
      #progressBar {
        height: 100%;
        width: 0;
        background: var(--text);
        border-radius: 99px;
      }

      .stat-strip {
        display: grid;
        grid-template-columns: 1fr 1px 1fr 1px 1fr 1px 1fr;
        background: var(--border2);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }
      .stat-sep {
        background: var(--border);
      }
      .stat-cell {
        padding: 0.75rem 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
        text-align: center;
      }
      .stat-lbl {
        font-size: 0.6rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 500;
      }
      .stat-val {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }
      .stat-val.hi {
        color: var(--accent);
      }

      .chart-row {
        display: flex;
        align-items: center;
        gap: 1.1rem;
      }

      .donut-wrap {
        position: relative;
        width: 88px;
        height: 88px;
        flex-shrink: 0;
      }
      .donut-svg {
        width: 88px;
        height: 88px;
        transform: rotate(-90deg);
      }
      .donut-bg {
        fill: none;
        stroke: var(--border);
        stroke-width: 7;
      }
      .donut-fill {
        fill: none;
        stroke: var(--accent);
        stroke-width: 7;
        stroke-linecap: round;

        stroke-dasharray: 239;
        stroke-dashoffset: 239;
      }
      .donut-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1.1;
      }
      .donut-pct {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: -0.04em;
      }
      .donut-lbl {
        font-size: 0.48rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      .bars-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
      .bar-row {
        display: flex;
        flex-direction: column;
        gap: 0.22rem;
      }
      .bar-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.67rem;
        color: var(--muted);
      }
      .bar-meta strong {
        color: var(--text);
        font-weight: 600;
      }
      .bar-track {
        height: 4px;
        background: var(--border);
        border-radius: 99px;
        overflow: hidden;
      }
      .bar-fill {
        height: 100%;
        width: 0;
        border-radius: 99px;
      }
      #barBefore {
        background: var(--muted);
      }
      #barAfter {
        background: var(--accent);
      }

      .done-msg {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text);
        text-align: center;
        letter-spacing: -0.01em;
      }

      .download-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background: var(--accent);
        color: #0c0c0c;
        font-size: 0.88rem;
        font-weight: 700;
        font-family: inherit;
        letter-spacing: -0.01em;
        border: none;
        border-radius: 7px;
        cursor: pointer;
        text-decoration: none;
        text-align: center;
        transition:
          opacity 0.14s,
          transform 0.12s;
        flex-shrink: 0;
      }
      .download-btn:hover {
        opacity: 0.86;
        transform: translateY(-1px);
      }
      .download-btn:active {
        transform: translateY(0);
      }

      .ms {
        font-family: "Material Symbols Outlined";
        font-weight: normal;
        font-style: normal;
        font-size: 18px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-feature-settings: "liga";
        font-feature-settings: "liga";
        -webkit-font-smoothing: antialiased;
        vertical-align: -4px;
        user-select: none;
        -webkit-user-select: none;
      }
      .done-msg .ms {
        font-size: 20px;
        color: var(--accent);
        vertical-align: -5px;
        margin-right: 4px;
      }
      .error-msg .ms {
        font-size: 16px;
        vertical-align: -3px;
        margin-right: 4px;
      }

      /* ── Mobile responsive ── */
      @media (max-width: 540px) {
        body {
          padding: 1.5rem 0.75rem 2.5rem;
          justify-content: flex-start;
          align-items: stretch;
        }
        .header {
          max-width: 100%;
          margin-bottom: 1rem;
        }
        .card {
          max-width: 100%;
          padding: 1rem;
        }
        .dropzone {
          padding: 1.5rem 1rem;
          min-height: 150px;
          touch-action: manipulation;
        }
      }

      @media (max-width: 400px) {
        .header h1 {
          font-size: 1.1rem;
        }
        .card {
          padding: 0.875rem;
        }
        .stat-strip {
          gap: 0;
        }
        .stat-cell {
          padding: 0.6rem 0.25rem;
        }
        .stat-val {
          font-size: 0.72rem;
        }
        .stat-lbl {
          font-size: 0.5rem;
        }
        .chart-row {
          flex-direction: column;
          align-items: center;
          gap: 0.75rem;
        }
        .donut-wrap {
          width: 80px;
          height: 80px;
        }
        .donut-svg {
          width: 80px;
          height: 80px;
        }
        .bars-section {
          width: 100%;
        }
        .done-msg {
          font-size: 0.875rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-top">
        <h1>Amazing <em>Compression</em> Tech</h1>
        <div class="lang-row">
          <button class="lang-btn" data-lang="en" type="button">EN</button>
          <button class="lang-btn" data-lang="ja" type="button">日本語</button>
        </div>
      </div>
      <p class="subtitle" data-i18n="subtitle">
        Drop any image. We compress it to the absolute limit.
      </p>
    </header>

    <div class="card">
      <label id="dropzone" class="dropzone" for="fileInput">
        <svg
          class="dz-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
          <polyline points="8 12 12 8 16 12"></polyline>
          <line x1="12" y1="8" x2="12" y2="20"></line>
        </svg>
        <span class="dz-main" data-i18n="selectFile"
          >Click here or drag &amp; drop an image</span
        >
        <span class="dz-hint" data-i18n="uploadHint"
          >PNG · JPEG · GIF · WebP · and more</span
        >
      </label>
      <input type="file" id="fileInput" accept="image/*,video/*,audio/*" />

      <div id="filePreview" class="file-preview" style="display:none">
        <img id="previewImg" alt="" />
        <span id="previewIcon" class="ms preview-icon" aria-hidden="true" style="display:none"></span>
        <div class="file-meta">
          <span id="previewName" class="file-name"></span>
          <span id="previewType" class="file-type"></span>
        </div>
      </div>

      <div id="errorMsg" class="error-msg" style="display:none">
        <span class="ms" aria-hidden="true">warning</span><span id="errorText"
        ></span>
      </div>

      <div id="result" style="display:none; position:relative">
        <div class="divider"></div>

        <!-- phase 1: analyzing -->
        <div id="phaseAnalyzing" class="phase">
          <div class="phase-row">
            <div class="spinner"></div>
            <span class="phase-label" data-i18n="analyzing">Analyzing…</span>
          </div>
        </div>

        <!-- phase 2: compressing -->
        <div id="phaseCompressing" class="phase">
          <div class="progress-header">
            <span class="progress-header-label" data-i18n="compressing"
              >Compressing…</span
            >
            <span id="progressPct">0%</span>
          </div>
          <div class="progress-track">
            <div id="progressBar"></div>
          </div>
        </div>

        <!-- phase 3: done -->
        <div id="phaseDone" class="phase">
          <!-- 3-stat strip: before / after / saved / time -->
          <div class="stat-strip">
            <div class="stat-cell">
              <span class="stat-lbl" data-i18n="before">Before</span>
              <span class="stat-val" id="sizeBeforeLabel">—</span>
            </div>
            <div class="stat-sep"></div>
            <div class="stat-cell">
              <span class="stat-lbl" data-i18n="after">After</span>
              <span class="stat-val hi" id="sizeAfterLabel">0 B</span>
            </div>
            <div class="stat-sep"></div>
            <div class="stat-cell">
              <span class="stat-lbl" data-i18n="savings">Saved</span>
              <span class="stat-val hi" id="savingsVal">—</span>
            </div>
            <div class="stat-sep"></div>
            <div class="stat-cell">
              <span class="stat-lbl" data-i18n="elapsed">Time</span>
              <span class="stat-val" id="elapsedVal">—</span>
            </div>
          </div>

          <!-- donut + bars -->
          <div class="chart-row">
            <div class="donut-wrap">
              <svg class="donut-svg" viewBox="0 0 88 88" aria-hidden="true">
                <circle class="donut-bg" cx="44" cy="44" r="38"></circle>
                <circle id="donutFill" class="donut-fill" cx="44" cy="44" r="38"
                ></circle>
              </svg>
              <div class="donut-center">
                <span class="donut-pct">100%</span>
                <span class="donut-lbl" data-i18n="ratio">ratio</span>
              </div>
            </div>
            <div class="bars-section">
              <div class="bar-row">
                <div class="bar-meta">
                  <span data-i18n="before">Before</span>
                  <strong id="barBeforeLabel">—</strong>
                </div>
                <div class="bar-track">
                  <div class="bar-fill" id="barBefore"></div>
                </div>
              </div>
              <div class="bar-row">
                <div class="bar-meta">
                  <span data-i18n="after">After</span>
                  <strong id="barAfterLabel">0 B</strong>
                </div>
                <div class="bar-track">
                  <div class="bar-fill" id="barAfter"></div>
                </div>
              </div>
            </div>
          </div>

          <p class="done-msg" id="message">
            <span class="ms" aria-hidden="true">check_circle</span><span
              data-i18n="compressed">Compressed 100%!</span
            >
          </p>

          <a id="downloadBtn" class="download-btn" download>
            <span
              class="ms"
              style="font-size:17px;vertical-align:-4px;margin-right:2px"
              aria-hidden="true">download</span
            >
            <span data-i18n="download">Download compressed file</span>
          </a>
        </div>
      </div><!-- #result -->
    </div><!-- .card -->

    <script is:inline>
      (function () {
        var t = window.__t;
        var locale = window.__locale;

        function fmt(n) {
          if (n < 1024) return n + " B";
          if (n < 1048576) return (n / 1024).toFixed(1) + " KB";
          return (n / 1048576).toFixed(2) + " MB";
        }

        function applyT() {
          document.querySelectorAll("[data-i18n]").forEach(function (el) {
            var k = el.getAttribute("data-i18n");
            if (t[k] !== undefined) el.textContent = t[k];
          });
          document.title = t.title;
          document.querySelectorAll(".lang-btn").forEach(function (btn) {
            var active = btn.getAttribute("data-lang") === locale;
            btn.setAttribute("aria-pressed", String(active));
            btn.classList.toggle("active", active);
          });
        }

        document.querySelectorAll(".lang-btn").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var l = btn.getAttribute("data-lang");
            try {
              localStorage.setItem("act-lang", l);
            } catch (e) {}
            window.__locale = l;
            window.__t = l === "ja" ? window.__ja : window.__en;
            t = window.__t;
            locale = l;
            document.documentElement.lang = l;
            document.documentElement.setAttribute("data-locale", l);
            applyT();
            if (_currentFile) updateSizeLabels(_currentFile.size);
          });
        });

        applyT();

        var _currentFile = null;

        /*
        showPhase — zero-flash phase switching
        Pattern:
          1. Hide all phases (display:none).
          2. Reset animated values while hidden
             (browser ignores transitions on hidden els → instant reset).
          3. Show target (display:flex via .vis class).
          4. Caller calls forceReflow() immediately after to commit
             the reset values as the painted "from" state.
          5. Caller then sets transition + new values → animates.
        This way the element NEVER appears in an intermediate state.
      */
        function showPhase(id) {
          ["phaseAnalyzing", "phaseCompressing", "phaseDone"].forEach(
            function (pid) {
              var el = document.getElementById(pid);
              el.classList.remove("vis");
            },
          );

          if (id === "phaseDone") {
            var df = document.getElementById("donutFill");
            if (df) {
              df.style.transition = "none";
              df.style.strokeDashoffset = "239";
            }
            var bb = document.getElementById("barBefore");
            if (bb) {
              bb.style.transition = "none";
              bb.style.width = "0";
            }
            var ab = document.getElementById("barAfter");
            if (ab) {
              ab.style.transition = "none";
              ab.style.width = "0";
            }
          }
          if (id === "phaseCompressing") {
            var pb = document.getElementById("progressBar");
            if (pb) {
              pb.style.transition = "none";
              pb.style.width = "0";
            }
          }

          document.getElementById(id).classList.add("vis");
        }

        function forceReflow(el) {
          void (el || document.body).getBoundingClientRect();
        }

        function updateSizeLabels(bytes) {
          var sbl = document.getElementById("sizeBeforeLabel");
          if (sbl) sbl.textContent = fmt(bytes);
          var bbl = document.getElementById("barBeforeLabel");
          if (bbl) bbl.textContent = fmt(bytes);
          var sv = document.getElementById("savingsVal");
          if (sv) sv.textContent = fmt(bytes);
        }

        function handleFile(file) {
          _currentFile = file;

          var errorMsg = document.getElementById("errorMsg");
          errorMsg.style.display = "none";

          if (!file.type.startsWith("image/") && !file.type.startsWith("video/") && !file.type.startsWith("audio/")) {
            document.getElementById("errorText").textContent = t.notSupported;
            errorMsg.style.display = "block";
            document.getElementById("result").style.display = "none";
            return;
          }

          var preview = document.getElementById("filePreview");
          var img = document.getElementById("previewImg");
          var icon = document.getElementById("previewIcon");
          document.getElementById("previewName").textContent = file.name;
          document.getElementById("previewType").textContent =
            file.type + " · " + fmt(file.size);
          if (file.type.startsWith("image/")) {
            img.src = URL.createObjectURL(file);
            img.style.display = "block";
            icon.style.display = "none";
          } else {
            img.src = "";
            img.style.display = "none";
            icon.textContent = file.type.startsWith("video/") ? "videocam" : "music_note";
            icon.style.display = "flex";
          }
          preview.style.display = "flex";

          document.getElementById("result").style.display = "block";

          showPhase("phaseAnalyzing");
          var _startTime = performance.now();

          setTimeout(function () {
            showPhase("phaseCompressing");
            var pctEl = document.getElementById("progressPct");
            var pb = document.getElementById("progressBar");
            pctEl.textContent = "0%";

            forceReflow(pb);
            pb.style.transition = "width 0.85s cubic-bezier(0.4,0,0.2,1)";
            pb.style.width = "100%";
            setTimeout(function () {
              pctEl.textContent = "100%";
            }, 850);

            setTimeout(function () {
              updateSizeLabels(file.size);

              var elapsed = performance.now() - _startTime;
              var ev = document.getElementById("elapsedVal");
              if (ev) {
                ev.textContent =
                  elapsed < 1000
                    ? Math.round(elapsed) + " ms"
                    : (elapsed / 1000).toFixed(2) + " s";
              }

              showPhase("phaseDone");
              applyT();

              var df2 = document.getElementById("donutFill");
              var bb2 = document.getElementById("barBefore");
              forceReflow(document.getElementById("phaseDone"));
              if (df2) {
                df2.style.transition =
                  "stroke-dashoffset 0.85s cubic-bezier(0.4,0,0.2,1)";
                df2.style.strokeDashoffset = "0";
              }
              if (bb2) {
                bb2.style.transition = "width 0.85s cubic-bezier(0.4,0,0.2,1)";
                bb2.style.width = "100%";
              }

              var blob = new Blob([], { type: file.type });
              var dl = document.getElementById("downloadBtn");
              var rand6 = Math.random().toString(36).slice(2, 8);
              dl.href = URL.createObjectURL(blob);
              dl.download = "amazing-" + rand6 + "_" + file.name;
            }, 950);
          }, 480);
        }

        document
          .getElementById("fileInput")
          .addEventListener("change", function () {
            if (this.files && this.files.length) handleFile(this.files[0]);
            this.value = "";
          });

        var dz = document.getElementById("dropzone");
        dz.addEventListener("dragover", function (e) {
          e.preventDefault();
          dz.classList.add("over");
        });
        dz.addEventListener("dragleave", function (e) {
          if (!dz.contains(e.relatedTarget)) dz.classList.remove("over");
        });
        dz.addEventListener("drop", function (e) {
          e.preventDefault();
          dz.classList.remove("over");
          var files = e.dataTransfer && e.dataTransfer.files;
          if (files && files.length) handleFile(files[0]);
        });
      })();
    </script>
  </body>
</html>
